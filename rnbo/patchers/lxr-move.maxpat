fx_p3 = 0;\n@param({min: 0, max: 127}) fx_p4 = 0;\n@param({min: 0, max: 2}) fx_drive_type = 0;\n@param({min: 0, max: 5}) fx_comp_ratio = 0;\n@param({min: 0, max: 5}) fx_ring_wave = 0;\n@param({min: 0, max: 1}) fx_delay_type = 0;\n@param({min: 0, max: 5}) fx_out = 0;\n@param({min: 20, max: 300}) bpm = 120;\n@param({min: 0, max: 65535}) seq_d1_steps = 4369;\n@param({min: 0, max: 65535}) seq_d2_steps = 0;\n@param({min: 0, max: 65535}) seq_d3_steps = 0;\n@param({min: 0, max: 65535}) seq_sn_steps = 4112;\n@param({min: 0, max: 65535}) seq_cy_steps = 0;\n@param({min: 0, max: 65535}) seq_ch_steps = 21845;\n@param({min: 0, max: 65535}) seq_oh_steps = 0;\n@param({min: 0, max: 65535}) seq_d1_accents = 0;\n@param({min: 0, max: 65535}) seq_d2_accents = 0;\n@param({min: 0, max: 65535}) seq_d3_accents = 0;\n@param({min: 0, max: 65535}) seq_sn_accents = 0;\n@param({min: 0, max: 65535}) seq_cy_accents = 0;\n@param({min: 0, max: 65535}) seq_ch_accents = 4369;\n@param({min: 0, max: 65535}) seq_oh_accents = 0;\n@param({min: 1, max: 16}) seq_d1_length = 16;\n@param({min: 1, max: 16}) seq_d2_length = 16;\n@param({min: 1, max: 16}) seq_d3_length = 16;\n@param({min: 1, max: 16}) seq_sn_length = 16;\n@param({min: 1, max: 16}) seq_cy_length = 16;\n@param({min: 1, max: 16}) seq_ch_length = 16;\n@param({min: 1, max: 16}) seq_oh_length = 16;\n@param({min: 0, max: 127}) seq_swing = 0;\n@param({min: 1, max: 127}) seq_velocity = 100;\n@param({min: 1, max: 127}) seq_accent_velocity = 127;\n\nconst N = 64;                 // samples per control block (OUTPUT_DMA_SIZE)\nconst FS_REF = 44140;         // the hardware sample rate (REAL_FS)\nconst TWO32 = 4294967296;\nconst FLT_MAX = 3.4028234663852886e38;\nconst WTS = 11265;            // one waveform: 11 band-limited tables of 1024 + 1 wrap sample\nconst TRL = 2205;             // transient sample length\n\n// waveform numbers (enum OscWaveforms)\nconst W_SINE = 0;\nconst W_NOISE = 4;\nconst W_PWM = 5;\n// filter types (enum filterTypeEnum)\nconst F_LP = 1;\nconst F_HP = 2;\nconst F_BP = 3;\nconst F_UBP = 4;\nconst F_NOTCH = 5;\nconst F_PEAK = 6;\nconst F_LP2 = 7;\nconst F_OFF = 8;\n// amp envelope states\nconst EG_STOPPED = 0;\nconst EG_A = 1;\nconst EG_D = 2;\nconst EG_REPEAT = 3;\n// envelope time curves (SlopeEg2.c, Decay.c)\nconst K_ATTACK = 197.99999999999983;\nconst K_DECAY = 1997.9999999999982;\nconst K_PITCH = 198.0001983642578;    // float: 2 * 0.99f / (1.f - 0.99f)\n\n// ---------------------------------------------------------------- tables\n@state SINE = new FixedDoubleArray(4097);\n@state WT = new FixedDoubleArray(33795);      // tri, saw, rect (WTS each)\n@state TR = new FixedDoubleArray(26460);      // 12 transient samples\n@state ECC83 = new FixedDoubleArray(129);\n@state DIODE = new FixedDoubleArray(258);\n@state NOTEF = new FixedDoubleArray(128);\n@state MT = new FixedDoubleArray(229);        // modulation target list -> parameter number\n@state HASPTR = new FixedDoubleArray(256);    // parameters a modulator may change\n\n// ---------------------------------------------------------------- engine state\n@state booted = 0;\n@state fsr = 44140;\n@state kr = 1;                // FS_REF / samplerate: keeps per-block timings in seconds\n@state blockPos = 64;\n@state SCR = new FixedDoubleArray(384);       // six 64-sample work buffers\n@state OUTB = new FixedDoubleArray(256);      // out L, out R, out2 L, out2 R\n@state FXB = new FixedDoubleArray(128);       // FX bus, interleaved stereo\n@state P = new FixedDoubleArray(256);         // current value of every LXR parameter\n@state rngS = new FixedDoubleArray(24);      // noise streams: oscillators 0-15, LFOs 16-21\n@state curBpm = 120;\n\n// sequencer\n@state sqOn = new FixedDoubleArray(7);       // step bits per track\n@state sqAcc = new FixedDoubleArray(7);      // accent bits per track\n@state sqLen = new FixedDoubleArray(7);      // track length 1-16\n@state sqSwing = 0;\n@state sqVel = 100;\n@state sqAccVel = 127;\n@state sqRun = 0;\n@state sqMutes = 0;\n@state sqGlobal = 0;                          // steps played since start\n@state sqTimer = 0;                           // samples until the next step\n@state sqCtl = -1;\n@state sqActive = new FixedDoubleArray(7);    // blocks left in a trigger's LED flash\n@state STAT = new FixedDoubleArray(18);\n@state scNan = 0;\n\n// triggers\n@state tLast = new FixedDoubleArray(8);\n@state tPend = new FixedDoubleArray(8);\n@state tVel = new FixedDoubleArray(8);\n@state tNote = new FixedDoubleArray(8);\n@state tCount = new FixedDoubleArray(8);      // triggers per slot (for tests)\n\n// oscillators: 0/1 Drum1 osc/modBuf, 2/3 Drum2, 4/5 Drum3, 6 snare osc, 7 snare noise,\n// 8/9/10 cymbal osc/mod1/mod2, 11/12/13 hihat osc/mod1/mod2, 14 ring modulator\n@state oPhase = new FixedDoubleArray(16);\n@state oInc = new FixedDoubleArray(16);\n@state oWave = new FixedDoubleArray(16);\n@state oTbl = new FixedDoubleArray(16);\n@state oFreq = new FixedDoubleArray(16);\n@state oPitch = new FixedDoubleArray(16);\n@state oFm = new FixedDoubleArray(16);\n@state oOut = new FixedDoubleArray(16);\n@state oCoarse = new FixedDoubleArray(16);\n@state oFine = new FixedDoubleArray(16);\n@state oBase = new FixedDoubleArray(16);\n\n// per voice (0-2 drums, 3 snare, 4 cymbal, 5 hihat)\n@state vol = new FixedDoubleArray(6);\n@state velo = new FixedDoubleArray(6);\n@state pan = new FixedDoubleArray(6);\n@state panL = new FixedDoubleArray(6);\n@state panR = new FixedDoubleArray(6);\n@state volMod = new FixedDoubleArray(6);\n@state pwm = new FixedDoubleArray(6);\n@state routing = new FixedDoubleArray(6);\n@state fader = new FixedDoubleArray(6);       // smoothing of the (absent) channel faders\n@state egVol = new FixedDoubleArray(6);\n@state dShape = new FixedDoubleArray(6);      // voice distortion\n@state fmA1 = new FixedDoubleArray(6);        // cymbal/hihat modBuf osc gains\n@state fmA2 = new FixedDoubleArray(6);\n// transient generator\n@state trWave = new FixedDoubleArray(6);\n@state trVol = new FixedDoubleArray(6);\n@state trPitch = new FixedDoubleArray(6);\n@state trPhase = new FixedDoubleArray(6);\n@state snap = new FixedDoubleArray(6);\n// amp envelope (SlopeEg2)\n@state aeAttack = new FixedDoubleArray(6);\n@state aeDecay = new FixedDoubleArray(6);\n@state aeSlope = new FixedDoubleArray(6);\n@state aeInv = new FixedDoubleArray(6);\n@state aeRepeat = new FixedDoubleArray(6);\n@state aeRepCnt = new FixedDoubleArray(6);\n@state aeValue = new FixedDoubleArray(6);\n@state aeState = new FixedDoubleArray(6);\n// pitch envelope (DecayEg), drums and snare\n@state peDecay = new FixedDoubleArray(6);\n@state peSlope = new FixedDoubleArray(6);\n@state peValue = new FixedDoubleArray(6);\n@state pAmt = new FixedDoubleArray(6);\n// state variable filter\n@state fType = new FixedDoubleArray(6);\n@state svF = new FixedDoubleArray(6);\n@state svG = new FixedDoubleArray(6);\n@state svQ = new FixedDoubleArray(6);\n@state svS1 = new FixedDoubleArray(6);\n@state svS2 = new FixedDoubleArray(6);\n@state svA = new FixedDoubleArray(6);\n@state svB = new FixedDoubleArray(6);\n@state svDrive = new FixedDoubleArray(6);\n// LFOs\n@state lPhase = new FixedDoubleArray(6);\n@state lInc = new FixedDoubleArray(6);\n@state lWave = new FixedDoubleArray(6);\n@state lRetrig = new FixedDoubleArray(6);\n@state lOffset = new FixedDoubleArray(6);\n@state lRnd = new FixedDoubleArray(6);\n@state lSync = new FixedDoubleArray(6);\n@state lFreq = new FixedDoubleArray(6);\n@state lAmount = new FixedDoubleArray(6);\n@state lDest = new FixedDoubleArray(6);\n// velocity modulators\n@state vmAmount = new FixedDoubleArray(6);\n@state vmDest = new FixedDoubleArray(6);\n@state vmLast = new FixedDoubleArray(6);\n// sample rate reduction (index 6 = all voices)\n@state decRate = new FixedDoubleArray(7);\n@state decCnt = new FixedDoubleArray(6);\n@state decHold = new FixedDoubleArray(6);\n// drums only\n@state fmAmt = new FixedDoubleArray(3);\n@state mixOscs = new FixedDoubleArray(3);\n@state ampIn = new FixedDoubleArray(3);\n@state lastGain = new FixedDoubleArray(3);\n@state mixVolB = new FixedDoubleArray(3);\n@state driveB = new FixedDoubleArray(3);\n// snare / hihat\n@state snMix = 0;\n@state hhDecClosed = 0;\n@state hhDecOpen = 0;\n\n// FX bus\n@state fxType = 0;\n@state fxRouting = 0;\n@state fxDryWet = 0;\n@state fxP = new FixedDoubleArray(4);\n// master distortion\n@state dsType = 0;\n@state dsDrive = 1;\n@state dsP1 = 1;\n@state dsP2 = 0;\n@state dsP3 = 0;\n@state dsHp1 = new FixedDoubleArray(2);\n@state dsHp3 = new FixedDoubleArray(2);\n@state dsLp1 = new FixedDoubleArray(2);\n@state dsLp2 = new FixedDoubleArray(2);\n@state dsLp3 = new FixedDoubleArray(2);\n@state dsSlew = new FixedDoubleArray(2);\n@state dsLast = new FixedDoubleArray(2);\n// compressor\n@state cTresh = 3;\n@state cAttack = 0.1;\n@state cRelease = 300;\n@state cRatio = 0;\n@state cMarkup = 1;\n@state cEnv = 0;\n// delay (FX_BUFFER is shared by both lines in ping-pong mode, as in the firmware)\n@state DLB = new FixedDoubleArray(32768);\n@state dlOld = 0;\n@state dlNew = 0;\n@state dlWrite = 1628;\n@state dlFracNew = 0;\n@state dlFracOld = 0;\n@state dlInterp = 0;\n@state dlStep = 0;\n@state dlT0 = 0;\n@state dlT1 = 0;\n@state dlU0 = 0;\n@state dlU1 = 0;\n@state dlFb = 0.7;\n@state dlRange = 0;\n@state dlTime = 0;\n@state dlPendTime = 0;\n@state dlPending = 0;\n@state dlToneR = 0.01;\n@state dlToneB = 0;\n@state dlTone2B = 0;\n@state dlType = 0;\n\n// ================================================================ number helpers\n// C float -> uint32 on the Cortex-M7: truncate, negative and NaN -> 0, saturate at the top\nfunction f2u(x) {\n\tif (x > 0) {\n\t\tif (x >= 4294967295) return 4294967295;\n\t\treturn trunc(x);\n\t}\n\treturn 0;\n}\n\nfunction wrap32(x) {\n\treturn x - TWO32 * floor(x / TWO32);\n}\n\nfunction wrap16(x) {\n\treturn x - 65536 * floor((x + 32768) / 65536);\n}\n\nfunction sat16(x) {\n\tif (x > 32767) return 32767;\n\tif (x < -32768) return -32768;\n\treturn x;\n}\n\n// C float -> int16_t: truncate, keep the low 16 bits\nfunction i16(x) {\n\treturn wrap16(trunc(x));\n}\n\n// __SSAT(x, 16) of a float argument\nfunction ssat(x) {\n\treturn sat16(trunc(x));\n}\n\n// fr(): round to the nearest C float (Veltkamp split: 53 - 29 = 24 significant bits).\n// The firmware computes in single precision, and where a result is truncated to an\n// integer (16-bit samples, phase offsets) the float rounding decides the last step.\nfunction fr(x) {\n\tlet c = x * 536870913;\n\treturn c - (c - x);\n}\n\n// round to IEEE half precision (the delay line stores __fp16)\nfunction f16(x) {\n\tif (abs(x) < 0.00006103515625) return floor(x * 16777216 + 0.5) / 16777216;\n\tlet c = x * 4398046511105;\n\treturn c - (c - x);\n}\n\nfunction clamp01(x) {\n\tif (x < 0) return 0;\n\tif (x > 1) return 1;\n\treturn x;\n}\n\n// k = 2s/(1-s) waveshaper used for envelope curves and parameter scaling\nfunction egCurve(val, slope) {\n\treturn (1 + slope) * val / (1 + slope * abs(val));\n}\n\n// valueShaperF2F (float maths)\nfunction valueShaper(val, shape) {\n\tlet k = fr(fr(2 * shape) / fr(1.000100016593933 - shape));\n\treturn fr(fr(fr(1 + k) * val) / fr(1 + fr(k * abs(val))));\n}\n\n// Stand-in for the hardware RNG: one 32-bit LCG per noise source (the same streams as\n// the C reference build uses), halves swapped so the low 16 bits are well mixed.\nfunction rng32(k) {\n\tlet s = wrap32(rngS[k] * 1664525 + 1013904223);\n\trngS[k] = s;\n\tlet hi = floor(s / 65536);\n\tlet lo = s - hi * 65536;\n\treturn lo * 65536 + hi;\n}\n\n// (int16_t)GetRngValue()\nfunction rng16(k) {\n\tlet r = rng32(k);\n\tlet lo = r - 65536 * floor(r / 65536);\n\tif (lo >= 32768) return lo - 65536;\n\treturn lo;\n}\n\n// ================================================================ oscillators\nfunction mainOsc(v) {\n\tif (v < 3) return 2 * v;\n\tif (v == 3) return 6;\n\tif (v == 4) return 8;\n\treturn 11;\n}\n\n// which of the 11 band-limited tables to use (freqToTableIndex incl. its uint8 quirk:\n// everything below 440 Hz lands on table 4)\nfunction tableIndex(f) {\n\tlet v = f2u(fr(f / 440));\n\tif (v < 1) return 4;\n\tlet l = 0;\n\tfor (let k = 0; k < 32; k++) {\n\t\tif (v < 2) break;\n\t\tv = floor(v / 2);\n\t\tl = l + 1;\n\t}\n\treturn min(10, l + 5);\n}\n\nfunction oscSetFreq(o) {\n\tlet f = fr(oFreq[o] * oPitch[o]);\n\tlet w = oWave[o];\n\tif (w == W_SINE || w == W_NOISE) {\n\t\toInc[o] = f2u(fr(4096 * f / fsr) * 1048576);\n\t} else if (w <= W_PWM) {\n\t\toInc[o] = f2u(fr(1024 * f / fsr) * 4194304);\n\t\toTbl[o] = tableIndex(f);\n\t} else {\n\t\toInc[o] = f2u(fr(1024 * f / fsr) * 131072);\n\t}\n}\n\nfunction oscRecalc(o) {\n\tlet cent = fr(1 + fr(fr(fr(oFine[o] / 127) - 0.5) * 0.05946314334869385));\n\tlet n = oCoarse[o] + oBase[o] - 60;\n\tif (n > 127) n = 127;\n\tif (n < 0) n = 0;\n\toFreq[o] = fr(NOTEF[n] * cent);\n}\n\nfunction oscBase(o, note) {\n\toBase[o] = note;\n\toscRecalc(o);\n}\n\nfunction sineAt(index) {\n\tlet itg = floor(index / 1048576);\n\tlet a = SINE[itg];\n\treturn a + floor((SINE[itg + 1] - a) * (index - itg * 1048576) / 1048576);\n}\n\nfunction wtAt(base, index) {\n\tlet itg = floor(index / 4194304);\n\tlet a = WT[base + itg];\n\treturn a + floor((WT[base + itg + 1] - a) * (index - itg * 4194304) / 4194304);\n}\n\n// calcNoiseBlock: sample and hold white noise, new value on every phase wrap\nfunction noiseBlock(o, dst, gain) {\n\tlet p = oPhase[o];\n\tlet inc = oInc[o];\n\tfor (let i = 0; i < N; i++) {\n\t\tp = p + inc;\n\t\tif (p >= TWO32) {\n\t\t\tp = p - TWO32;\n\t\t\toOut[o] = rng16(o);\n\t\t}\n\t\tSCR[dst + i] = i16(fr(oOut[o] * gain));\n\t}\n\toPhase[o] = p;\n}\n\n// phase of the second, shifted saw of the PWM wave: index + pwm * (UINT32_MAX / 2),\n// added up in float and saturated at the top\nfunction pwmIndex(index, pw) {\n\treturn f2u(fr(fr(index) + pw * 2147483648));\n}\n\n// calcNextOscSampleBlock\nfunction oscBlock(o, dst, gain, pw) {\n\tlet w = oWave[o];\n\tlet p = oPhase[o];\n\tlet inc = oInc[o];\n\tif (w == W_SINE) {\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tSCR[dst + i] = i16(fr(sineAt(p) * gain));\n\t\t\tp = wrap32(p + inc);\n\t\t}\n\t} else if (w <= 3) {\n\t\tlet base = (w - 1) * WTS + oTbl[o] * 1024;\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tSCR[dst + i] = i16(fr(wtAt(base, p) * gain));\n\t\t\tp = wrap32(p + inc);\n\t\t}\n\t} else if (w == W_NOISE) {\n\t\tnoiseBlock(o, dst, gain);\n\t\treturn;\n\t} else if (w == W_PWM) {\n\t\tlet base = WTS + oTbl[o] * 1024;\n\t\tlet smp = 0;\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tsmp = sat16(wtAt(base, p) - wtAt(base, pwmIndex(p, pw)));\n\t\t\tSCR[dst + i] = i16(fr(smp * gain));\n\t\t\tp = wrap32(p + inc);\n\t\t}\n\t\toOut[o] = smp;\n\t}\n\t// waveforms above PWM were sample playback, disabled in the firmware\n\toPhase[o] = p;\n}\n\n// calcNextOscSampleFmBlock: phase modulated by the block at modBuf. The modulation\n// index is (uint32_t)(int16 * float): rounded to float first, like the firmware, since\n// a one-step difference moves the phase by 1/8192 of a cycle.\nfunction oscFmBlock(o, modBuf, dst, gain, pw) {\n\tlet w = oWave[o];\n\tlet p = oPhase[o];\n\tlet inc = oInc[o];\n\tlet fm = oFm[o];\n\tif (w == W_SINE) {\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet index = wrap32(p + wrap32(f2u(fr(SCR[modBuf + i] * fm)) * 131072));\n\t\t\tSCR[dst + i] = i16(fr(sineAt(index) * gain));\n\t\t\tp = wrap32(p + inc);\n\t\t}\n\t} else if (w <= 3) {\n\t\tlet base = (w - 1) * WTS + oTbl[o] * 1024;\n\t\tlet smp = 0;\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet index = wrap32(p + wrap32(f2u(fr(SCR[modBuf + i] * fm)) * 524288));\n\t\t\tsmp = wtAt(base, index);\n\t\t\tSCR[dst + i] = i16(fr(smp * gain));\n\t\t\tp = wrap32(p + inc);\n\t\t}\n\t\toOut[o] = smp;\n\t} else if (w == W_NOISE) {\n\t\tnoiseBlock(o, dst, gain);\n\t\treturn;\n\t} else if (w == W_PWM) {\n\t\tlet base = WTS + oTbl[o] * 1024;\n\t\tlet smp = 0;\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet index = wrap32(p + wrap32(f2u(fr(SCR[modBuf + i] * fm)) * 524288));\n\t\t\tsmp = sat16(wtAt(base, index) - wtAt(base, pwmIndex(index, pw)));\n\t\t\tSCR[dst + i] = i16(fr(smp * gain));\n\t\t\tp = wrap32(p + inc);\n\t\t}\n\t\toOut[o] = smp;\n\t}\n\toPhase[o] = p;\n}\n\n// ================================================================ building blocks\nfunction qaddBuf(dst, src) {\n\tfor (let i = 0; i < N; i++) SCR[dst + i] = sat16(SCR[dst + i] + SCR[src + i]);\n}\n\n// transient_calcBlock\nfunction transBlock(v, dst) {\n\tlet w = trWave[v];\n\tlet ph = trPhase[v];\n\tif (w <= 1 || ph >= 2311061504) {\n\t\tfor (let i = 0; i < N; i++) SCR[dst + i] = 0;\n\t\treturn;\n\t}\n\tlet base = (w - 2) * TRL;\n\tlet stp = trPitch[v] * 1048576 * kr;\n\tfor (let i = 0; i < N; i++) {\n\t\tif (ph < 2311061504) {\n\t\t\tSCR[dst + i] = i16(fr(trVol[v] * (TR[base + floor(ph / 1048576)] * 256)));\n\t\t\tph = f2u(fr(ph + stp));\n\t\t} else {\n\t\t\tSCR[dst + i] = 0;\n\t\t}\n\t}\n\ttrPhase[v] = ph;\n}\n\n// SnapEg_calc\nfunction snapCalc(v, tm) {\n\tlet ret = 0;\n\tif (snap[v] > 0) {\n\t\tret = fr(fr(snap[v] * snap[v]) * 24);\n\t\tsnap[v] = fr(snap[v] - fr(0.20000000298023224 * tm * kr));\n\t}\n\treturn ret;\n}\n\n// DecayEg_calc (pitch envelope)\nfunction decayCalc(v) {\n\tlet val = peValue[v];\n\tif (val > 0) val = fr(val - peDecay[v] * kr);\n\telse val = 0;\n\tpeValue[v] = val;\n\tlet sl = peSlope[v];\n\treturn fr(fr(fr(1 + sl) * val) / fr(1 + fr(sl * abs(val))));\n}\n\n// slopeEg2_calc (amp envelope)\nfunction aeCalc(v) {\n\tlet val = aeValue[v];\n\tlet st = aeState[v];\n\tif (st == EG_STOPPED) return 0;\n\tif (st == EG_REPEAT) {\n\t\tif (val > 0) {\n\t\t\tval = val - aeAttack[v] * kr;\n\t\t} else {\n\t\t\taeRepCnt[v] = aeRepCnt[v] - 1;\n\t\t\tif (aeRepCnt[v] < 0) aeRepCnt[v] = aeRepCnt[v] + 256;\n\t\t\tif (aeRepCnt[v] <= 0) aeState[v] = EG_D;\n\t\t\tval = 1;\n\t\t}\n\t\taeValue[v] = val;\n\t\treturn egCurve(val, aeSlope[v]);\n\t}\n\tif (st == EG_A) {\n\t\tval = val + aeAttack[v] * kr;\n\t\tif (val >= 1) {\n\t\t\tval = 1;\n\t\t\taeState[v] = EG_D;\n\t\t}\n\t\taeValue[v] = val;\n\t\treturn egCurve(val, aeInv[v]);\n\t}\n\tif (st == EG_D) {\n\t\tif (val > 0) {\n\t\t\tval = val - aeDecay[v] * kr;\n\t\t\taeValue[v] = val;\n\t\t\treturn egCurve(val, aeSlope[v]);\n\t\t}\n\t\taeValue[v] = 0;\n\t}\n\treturn 0;\n}\n\nfunction aeTrigger(v) {\n\tif (aeRepeat[v] == 0) {\n\t\taeState[v] = EG_A;\n\t} else {\n\t\taeState[v] = EG_REPEAT;\n\t\taeValue[v] = 1;\n\t}\n\taeRepCnt[v] = aeRepeat[v];\n}\n\n// slopeEg2_calcTime\nfunction egTime(itg, k) {\n\tlet val = itg / 127;\n\tlet ret = fr((1 - (1 + k) * val / (1 + k * abs(val))) * 2);\n\tif (ret > 1) return 1;\n\treturn ret;\n}\n\n// softClipTwo(): in * tanhXdX(0.5 * in), a Pade approximation of tanh\n// softClipTwo(): in * tanhXdX(0.5 * in), a Pade approximation of tanh. When the\n// filter state runs away the float maths overflows: num / inf = 0, inf / inf = NaN.\n// NaN is reported through scNan instead of being produced (it must never reach RNBO).\nfunction softClip(x) {\n\tlet h = fr(0.5 * x);\n\tlet a = fr(h * h);\n\tlet num = fr(fr(fr(a + 105) * a) + 945);\n\tlet den = fr(fr(fr(fr(15 * a) + 420) * a) + 945);\n\tif (den > FLT_MAX) {\n\t\tif (num > FLT_MAX) scNan = 1;\n\t\treturn 0;\n\t}\n\treturn fr(x * fr(num / den));\n}\n\nfunction fastTanh(x) {\n\tif (x < -1.9500000476837158) return -1;\n\tif (x > 1.9500000476837158) return 1;\n\treturn fr(fr(4.150000095367432 * x) / fr(4.289999961853027 + fr(x * x)));\n}\n\nfunction fastTan(x) {\n\tlet x2 = fr(x * x);\n\treturn fr(fr(fr(-15 * x) + fr(x * x2)) / fr(3 * fr(-5 + fr(2 * x2))));\n}\n\n// SVF_recalcFreq\nfunction svfRecalc(v) {\n\tsvG[v] = fastTan(fr(3.141592653589793 * svF[v] * kr));\n}\n\n// SVF_calcBlockZDF (also used by snare, cymbal and hihat: the reverb that would\n// switch them to the cheap variant is disabled in the firmware)\nfunction svfBlock(v, dst) {\n\tlet ft = fType[v];\n\tif (ft == F_OFF || ft < F_LP || ft > F_OFF) return;\n\tlet drive = svDrive[v];\n\tif (ft == F_LP2) {\n\t\t// alternative 2-pole lowpass (q in double, as written in the firmware)\n\t\tlet fl = fr(svF[v] * kr * 2.2100000381469727);\n\t\tlet q0 = 1 - svQ[v];\n\t\tlet q = fr(q0 * 1.4 + q0 / (1.0 - fl));\n\t\tlet a = svA[v];\n\t\tlet b = svB[v];\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet x = softClip(fr(fr(SCR[dst + i] / 32767) * drive));\n\t\t\ta = fr(a + fr(fl * fr(fr(x - a) + fr(q * fr(a - b)))));\n\t\t\tif (a > 1) a = 1;\n\t\t\telse if (a < -1) a = -1;\n\t\t\tb = fr(b + fr(fl * fr(a - b)));\n\t\t\tif (b > 1) b = 1;\n\t\t\telse if (b < -1) b = -1;\n\t\t\tSCR[dst + i] = ssat(fr(b * 32767));\n\t\t}\n\t\tsvA[v] = a;\n\t\tsvB[v] = b;\n\t\treturn;\n\t}\n\t// zero delay feedback state variable filter\n\tlet g = svG[v];\n\tlet R = svQ[v];\n\tif (svF[v] >= 0.44990000128746033) R = 1;\n\tlet ff = fr(g * g);\n\tlet s1 = svS1[v];\n\tlet s2 = svS2[v];\n\tlet g0 = fr(1 / fr(1 + fr(g * 2 * R)));\n\tlet f1 = fr(ff * g0);\n\tlet gg0 = fr(g * g0);\n\tlet den = fr(f1 + 1);\n\tlet blown = 0;\n\tscNan = 0;\n\tfor (let i = 0; i < N; i++) {\n\t\tif (blown != 0) {\n\t\t\t// the float state overflowed: the firmware's samples are NaN, which the\n\t\t\t// Cortex-M7 turns into 0, until the next block resets the state\n\t\t\tSCR[dst + i] = 0;\n\t\t\tcontinue;\n\t\t}\n\t\tlet x = softClip(fr(fr(SCR[dst + i] / 32767) * drive));\n\t\tlet y1 = fr(fr(fr(fr(f1 * x) + s2) + fr(gg0 * s1)) / den);\n\t\tlet xx = fr(x - y1);\n\t\tlet cs1 = softClip(s1);\n\t\tlet y0 = fr(fr(cs1 + fr(g * xx)) * g0);\n\t\tlet ugb = fr(2 * R * y0);\n\t\ts1 = fr(cs1 + fr(2 * g * fr(xx - ugb)));\n\t\ts2 = fr(s2 + fr(2 * g * y0));\n\t\tlet y = 0;\n\t\tif (ft == F_LP) y = fastTanh(y1);\n\t\telse if (ft == F_HP) y = fr(fr(x - ugb) - y1);\n\t\telse if (ft == F_BP) y = y0;\n\t\telse if (ft == F_UBP) y = ugb;\n\t\telse if (ft == F_NOTCH) y = fr(x - ugb);\n\t\telse y = fr(y1 - fr(fr(x - ugb) - y1));\n\t\tSCR[dst + i] = ssat(fr(y * 32767));\n\t\tif (scNan != 0) {\n\t\t\tblown = 1;\n\t\t\tSCR[dst + i] = 0;\n\t\t} else if (abs(s1) > FLT_MAX || abs(s2) > FLT_MAX) {\n\t\t\tblown = 1;\n\t\t}\n\t}\n\tif (blown != 0) {\n\t\ts1 = 0;\n\t\ts2 = 0;\n\t}\n\tsvS1[v] = s1;\n\tsvS2[v] = s2;\n}\n\n// calcDistBlock\n// calcDistBlock (and the per-sample part of calcDistBlockFiltered)\nfunction distBlock(v, dst) {\n\tlet s = dShape[v];\n\tfor (let i = 0; i < N; i++) SCR[dst + i] = shapeSample(SCR[dst + i], s);\n}\n\nfunction shapeSample(smp, s) {\n\tlet x = fr(smp / 32767);\n\tx = fr(fr(fr(1 + s) * x) / fr(1 + fr(s * abs(x))));\n\treturn i16(fr(x * 32767));\n}\n\n// mixer_decimateBlock\nfunction srReduce(v, dst) {\n\tlet inc = fr(decRate[v] * decRate[6]);\n\tfor (let i = 0; i < N; i++) {\n\t\tdecCnt[v] = fr(decCnt[v] + inc);\n\t\tif (decCnt[v] >= 1) {\n\t\t\tdecCnt[v] = fr(decCnt[v] - 1);\n\t\t\tdecHold[v] = SCR[dst + i];\n\t\t}\n\t\tSCR[dst + i] = decHold[v];\n\t}\n}\n\n// mixer_addDataToOutput (all output jacks count as plugged in)\nfunction mixAdd(v, src) {\n\tlet r = routing[v];\n\tlet pl = panL[v];\n\tlet pr = panR[v];\n\tif (r == 6) {\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet x = SCR[src + i];\n\t\t\tFXB[2 * i] = sat16(FXB[2 * i] + i16(fr(x * pl)));\n\t\t\tFXB[2 * i + 1] = sat16(FXB[2 * i + 1] + i16(fr(x * pr)));\n\t\t}\n\t} else if (r == 0 || r == 1) {\n\t\tlet c = 128;\n\t\tif (r == 1) c = 0;\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet x = SCR[src + i];\n\t\t\tOUTB[c + i] = sat16(OUTB[c + i] + i16(fr(x * pl)));\n\t\t\tOUTB[c + 64 + i] = sat16(OUTB[c + 64 + i] + i16(fr(x * pr)));\n\t\t}\n\t} else {\n\t\tlet c = 0;\n\t\tif (r == 2) c = 128;\n\t\telse if (r == 3) c = 192;\n\t\telse if (r == 5) c = 64;\n\t\tfor (let i = 0; i < N; i++) OUTB[c + i] = sat16(OUTB[c + i] + SCR[src + i]);\n\t}\n}\n\n// ================================================================ LFOs and modulation\nfunction lfoInc(freq, syncMode) {\n\tlet lsr = fsr / N;\n\tif (syncMode <= 0 || syncMode >= 12) return f2u(fr(freq / fr(lsr)) * TWO32);\n\tlet tf = 0;\n\tif (curBpm > 0) tf = fr(fr(curBpm / 60) / 4);\n\tlet sc = 1;\n\tif (syncMode == 1) sc = 0.25;\n\telse if (syncMode == 2) sc = 0.5;\n\telse if (syncMode == 3) sc = 1;\n\telse if (syncMode == 4) sc = 2;\n\telse if (syncMode == 5) sc = 3;\n\telse if (syncMode == 6) sc = 4;\n\telse if (syncMode == 7) sc = 6;\n\telse if (syncMode == 8) sc = 8;\n\telse if (syncMode == 9) sc = 12;\n\telse if (syncMode == 10) sc = 16;\n\telse sc = 32;\n\treturn f2u(fr(fr(tf * sc) / fr(lsr)) * TWO32);\n}\n\nfunction lfoSetFreq(l, f) {\n\tlet x = fr(0.0078125 + fr(f * 0.9921875));\n\tlFreq[l] = fr(fr(fr(x * x) * x) * 200);\n\tlInc[l] = lfoInc(lFreq[l], lSync[l]);\n}\n\n// lfo_calc\nfunction lfoCalc(l) {\n\tlet old = lPhase[l];\n\tlet ph = wrap32(old + f2u(fr(lInc[l])));\n\tlPhase[l] = ph;\n\tlet w = lWave[l];\n\tif (w == 0) return fr(fr(SINE[floor(ph / 1048576)] / 32767) + 1) / 2;\n\tif (w == 1) return fr(1 - abs(fr(fr(fr(ph) / TWO32) * 2 - 1)));\n\tif (w == 2) return fr(fr(ph) / TWO32);\n\tif (w == 3) return fr(fr(4294967295 - ph) / TWO32);\n\tif (w == 4) {\n\t\tif (ph > 2147483647) return 1;\n\t\treturn 0;\n\t}\n\tif (w == 5) {\n\t\tif (old > ph) lRnd[l] = fr(fr(rng32(16 + l)) / TWO32);\n\t\treturn lRnd[l];\n\t}\n\tif (w == 6) {\n\t\tlet x = fr(fr(ph) / TWO32);\n\t\treturn fr(fr(x * x) * x);\n\t}\n\tif (w == 7) {\n\t\tlet y = fr(fr(4294967295 - ph) / TWO32);\n\t\treturn fr(fr(y * y) * y);\n\t}\n\treturn 0;\n}\n\nfunction lfoRetrigger(voice) {\n\tfor (let l = 0; l < 6; l++) {\n\t\tif (lRetrig[l] == voice + 1) lPhase[l] = lOffset[l];\n\t}\n}\n\n// modNode_updateValue: move a parameter around its set value by +-amount\nfunction modUpdate(dest, amount, val) {\n\tif (HASPTR[dest] == 0) return;\n\tlet nv = clamp01(fr(fr(P[dest] / 127) + fr(amount * fr(fr(val * 2) - 1))));\n\tapplyLxrParam(dest, trunc(fr(nv * 127)), nv, 1);\n}\n\n// paramArray_setParameter: back to the value the parameter is set to\nfunction resetParam(dest) {\n\tif (HASPTR[dest] == 0) return;\n\tapplyLxrParam(dest, P[dest], fr(P[dest] / 127), 0);\n}\n\nfunction resetTargets() {\n\tfor (let i = 0; i < 6; i++) resetParam(vmDest[i]);\n\tfor (let i = 0; i < 6; i++) resetParam(lDest[i]);\n}\n\nfunction setVeloDest(i, target) {\n\tresetTargets();\n\tvmDest[i] = MT[target];\n}\n\nfunction setLfoDest(i, target) {\n\tresetTargets();\n\tlDest[i] = MT[target];\n}\n\nfunction veloMod(v, val) {\n\tvmLast[v] = val;\n\tmodUpdate(vmDest[v], vmAmount[v], val);\n}\n\n// ================================================================ parameters\nfunction waveVal(itg, flt, isMod, n) {\n\tif (isMod == 0) return itg;\n\treturn min(n - 1, trunc(n * flt));\n}\n\nfunction setLxrParam(idx, val) {\n\tP[idx] = val;\n\tapplyLxrParam(idx, val, fr(val / 127), 0);\n}\n\n// midiParser_ccHandler, by LXR parameter number. isMod: the call comes from an LFO or\n// velocity modulator (flt is then the modulated value and itg = flt * 127).\nfunction applyLxrParam(idx, itg, flt, isMod) {\n\tif (idx < 8) {\n\t\tif (idx == 1) oWave[0] = waveVal(itg, flt, isMod, 6);\n\t\telse if (idx == 2) oWave[2] = waveVal(itg, flt, isMod, 6);\n\t\telse if (idx == 3) oWave[4] = waveVal(itg, flt, isMod, 6);\n\t\telse if (idx == 4) oWave[6] = waveVal(itg, flt, isMod, 6);\n\t\telse if (idx == 6) oWave[8] = waveVal(itg, flt, isMod, 6);\n\t\telse if (idx == 7) oWave[11] = waveVal(itg, flt, isMod, 6);\n\t} else if (idx < 20) {\n\t\t// coarse / fine of the main oscillators\n\t\tlet o = mainOsc(floor((idx - 8) / 2));\n\t\tif (idx - 8 - 2 * floor((idx - 8) / 2) == 0) oCoarse[o] = itg;\n\t\telse oFine[o] = itg;\n\t\toscRecalc(o);\n\t} else if (idx < 27) {\n\t\tlet o = 1;\n\t\tif (idx == 21) o = 3;\n\t\telse if (idx == 22) o = 5;\n\t\telse if (idx == 23) o = 9;\n\t\telse if (idx == 24) o = 10;\n\t\telse if (idx == 25) o = 12;\n\t\telse if (idx == 26) o = 13;\n\t\toWave[o] = waveVal(itg, flt, isMod, 6);\n\t} else if (idx < 37) {\n\t\tif (idx == 27) oFreq[7] = fr(flt * 22000);\n\t\telse if (idx == 28) snMix = flt;\n\t\telse if (idx == 29) {\n\t\t\toCoarse[9] = itg;\n\t\t\toscRecalc(9);\n\t\t} else if (idx == 30) {\n\t\t\toCoarse[10] = itg;\n\t\t\toscRecalc(10);\n\t\t} else if (idx == 31) fmA1[4] = flt;\n\t\telse if (idx == 32) fmA2[4] = flt;\n\t\telse if (idx == 33) {\n\t\t\toCoarse[12] = itg;\n\t\t\toscRecalc(12);\n\t\t} else if (idx == 34) {\n\t\t\toCoarse[13] = itg;\n\t\t\toscRecalc(13);\n\t\t} else if (idx == 35) fmA1[5] = flt;\n\t\telse if (idx == 36) fmA2[5] = flt;\n\t} else if (idx < 43) {\n\t\t// SVF_directSetFilterValue(valueShaperF2F(f, FILTER_SHAPER))\n\t\tlet v = idx - 37;\n\t\tsvF[v] = fr(valueShaper(flt, -0.8999999761581421) * 0.44999998807907104);\n\t\tsvfRecalc(v);\n\t} else if (idx < 49) {\n\t\tlet v = idx - 43;\n\t\tsvQ[v] = fr(1 - flt);\n\t\tif (svQ[v] < 0.10000000149011612) svQ[v] = 0.019999999552965164;\n\t} else if (idx < 60) {\n\t\tlet k = idx - 49;\n\t\tlet v = floor(k / 2);\n\t\tif (k - 2 * v == 0) aeAttack[v] = egTime(itg, K_ATTACK);\n\t\telse aeDecay[v] = egTime(itg, K_DECAY);\n\t} else if (idx < 62) {\n\t\tif (idx == 60) hhDecClosed = egTime(itg, K_DECAY);\n\t\telse hhDecOpen = egTime(itg, K_DECAY);\n\t} else if (idx < 68) {\n\t\tlet v = idx - 62;\n\t\tlet a = ((itg / 127) - 0.5) * 1.999;\n\t\taeSlope[v] = 2 * a / (1 - a);\n\t\taeInv[v] = -2 * a / (1 + a);\n\t} else if (idx < 70) {\n\t\taeRepeat[idx - 65] = itg;\n\t} else if (idx < 74) {\n\t\t// DecayEg_calcTime\n\t\tlet val = fr(itg / 127);\n\t\tlet ret = fr(1 - fr(fr(fr(1 + K_PITCH) * val) / fr(1 + fr(K_PITCH * val)))) * 2;\n\t\tif (ret > 1) ret = 1;\n\t\tpeDecay[idx - 70] = ret;\n\t} else if (idx < 78) {\n\t\tlet val = fr(itg / 127);\n\t\tpAmt[idx - 74] = fr(fr(val * val) * 32);\n\t} else if (idx < 82) {\n\t\t// DecayEg_setSlope; at 127 the firmware divides by zero, here the curve just\n\t\t// gets as steep as at 126.99\n\t\tlet a = min(0.9999, fr(fr(itg / 127) - 0.5) * 2);\n\t\tpeSlope[idx - 78] = fr(2 * a / fr(1 - a));\n\t} else if (idx < 88) {\n\t\tlet k = idx - 82;\n\t\tlet v = floor(k / 2);\n\t\tif (k - 2 * v == 0) {\n\t\t\tfmAmt[v] = flt;\n\t\t} else {\n\t\t\toCoarse[2 * v + 1] = itg;\n\t\t\toscRecalc(2 * v + 1);\n\t\t}\n\t} else if (idx < 94) {\n\t\tvol[idx - 88] = flt;\n\t} else if (idx < 102) {\n\t\tif (idx < 97) pan[idx - 94] = itg;\n\t\telse if (idx > 98) pan[idx - 96] = itg;\n\t} else if (idx < 108) {\n\t\t// setDistortionShape\n\t\tlet s = fr(flt - 0.0078125);\n\t\tdShape[idx - 102] = fr(fr(2 * s) / fr(1 - s));\n\t} else if (idx < 115) {\n\t\tdecRate[idx - 108] = valueShaper(flt, -0.699999988079071);\n\t} else if (idx < 121) {\n\t\tlfoSetFreq(idx - 115, flt);\n\t} else if (idx < 127) {\n\t\tlAmount[idx - 121] = flt;\n\t} else if (idx < 128) {\n\t\t// bank change, not a sound parameter\n\t} else if (idx < 134) {\n\t\tsvDrive[idx - 128] = fr(0.4000000059604645 + fr(fr(flt * flt) * 6));\n\t} else if (idx < 137) {\n\t\tmixOscs[idx - 134] = 0;\n\t\tif (itg != 0) mixOscs[idx - 134] = 1;\n\t} else if (idx < 143) {\n\t\tvolMod[idx - 137] = 0;\n\t\tif (itg != 0) volMod[idx - 137] = 1;\n\t} else if (idx < 149) {\n\t\tvmAmount[idx - 143] = flt;\n\t} else if (idx < 155) {\n\t\t// velocity destination: handled by setVeloDest()\n\t} else if (idx < 161) {\n\t\tlWave[idx - 155] = waveVal(itg, flt, isMod, 8);\n\t} else if (idx < 173) {\n\t\t// LFO target voice/parameter: handled by setLfoDest()\n\t} else if (idx < 179) {\n\t\tif (isMod == 0) lRetrig[idx - 173] = itg;\n\t\telse lRetrig[idx - 173] = trunc(7 * flt);\n\t} else if (idx < 185) {\n\t\tlet l = idx - 179;\n\t\tlSync[l] = itg;\n\t\tlInc[l] = lfoInc(lFreq[l], itg);\n\t} else if (idx < 191) {\n\t\tlOffset[idx - 185] = f2u(flt * TWO32);\n\t} else if (idx < 197) {\n\t\tlet v = idx - 191;\n\t\tif (isMod == 0) {\n\t\t\tfType[v] = itg + 1;\n\t\t} else {\n\t\t\tlet t = trunc(7 * flt + 1);\n\t\t\tif (t >= F_OFF) t = F_OFF - 1;\n\t\t\tfType[v] = t;\n\t\t}\n\t} else if (idx < 203) {\n\t\ttrVol[idx - 197] = flt;\n\t} else if (idx < 209) {\n\t\tlet w = itg;\n\t\tif (isMod != 0) w = min(11, trunc(12 * flt));\n\t\tif (w >= 14) w = 0;\n\t\ttrWave[idx - 203] = w;\n\t} else if (idx < 215) {\n\t\t// 1.f + ((itg / 33.9f) - 0.75f), in float like the firmware\n\t\ttrPitch[idx - 209] = fr(1 + fr(fr(itg / 33.900001525878906) - 0.75));\n\t} else if (idx < 221) {\n\t\trouting[idx - 215] = itg;\n\t} else if (idx < 228) {\n\t\t// unused\n\t} else if (idx < 234) {\n\t\tpwm[idx - 228] = flt;\n\t} else if (idx == 234) {\n\t\tfxType = itg;\n\t\tfxUpdate();\n\t} else if (idx == 235) {\n\t\tfxRouting = itg;\n\t} else if (idx == 236) {\n\t\tfxDryWet = fr(itg / 100);\n\t} else if (idx == 237) {\n\t\tdsType = itg;\n\t} else if (idx < 242) {\n\t\tfxP[idx - 238] = flt;\n\t\tfxUpdate();\n\t} else if (idx == 242) {\n\t\tcompSetRatio(itg);\n\t} else if (idx == 243) {\n\t\toWave[14] = itg;\n\t} else if (idx == 245) {\n\t\tdlType = itg;\n\t}\n}\n\nfunction bpmChanged() {\n\tfor (let l = 0; l < 6; l++) lInc[l] = lfoInc(lFreq[l], lSync[l]);\n}\n\n// ================================================================ voices\nfunction updatePan(v) {\n\tpanL[v] = fr(sqrt(fr((127 - pan[v]) / 127)));\n\tpanR[v] = fr(sqrt(fr(pan[v] / 127)));\n}\n\n// phase an oscillator restarts at, depending on its waveform\nfunction startPhase(o, offset) {\n\tlet w = oWave[o];\n\tif (w == W_SINE) return f2u(fr(1072693248 * offset));\n\tif (w >= 1 && w <= 3) return f2u(fr(1069547520 * offset));\n\treturn 0;\n}\n\nfunction drumTrigger(v, vel, note) {\n\tlfoRetrigger(v);\n\tveloMod(v, fr(vel / 127));\n\tlet offset = 1;\n\tif (trWave[v] == 1) offset = fr(offset - trVol[v]);\n\tlet o = 2 * v;\n\tlet w = oWave[o];\n\tif (w == W_SINE) oPhase[o] = f2u(fr(1024 + fr(1072692224 * offset)));\n\telse if (w >= 1 && w <= 3) oPhase[o] = f2u(fr(1069547520 * offset));\n\telse oPhase[o] = 0;\n\toPhase[o + 1] = startPhase(o + 1, 1);\n\toscBase(o, note);\n\toscBase(o + 1, note);\n\tpeValue[v] = 1;\n\taeTrigger(v);\n\tvelo[v] = fr(vel / 127);\n\ttrPhase[v] = 0;\n\tsnap[v] = 1;\n\tsvS1[v] = 0;\n\tsvS2[v] = 0;\n\tsvA[v] = 0;\n\tsvB[v] = 0;\n\tupdatePan(v);\n}\n\nfunction snareTrigger(vel, note) {\n\tlfoRetrigger(3);\n\tveloMod(3, fr(vel / 127));\n\tlet offset = 1;\n\tif (trWave[3] == 1) offset = fr(offset - trVol[3]);\n\toPhase[6] = startPhase(6, offset);\n\tpeValue[3] = 1;\n\taeTrigger(3);\n\tvelo[3] = fr(vel / 127);\n\toscBase(6, note);\n\ttrPhase[3] = 0;\n\tsnap[3] = 1;\n\tupdatePan(3);\n}\n\n// cymbal (v = 4) and hihat (v = 5, open = 0/1)\nfunction metalTrigger(v, vel, isOpen, note) {\n\tlfoRetrigger(v);\n\tveloMod(v, fr(vel / 127));\n\tlet offset = 1;\n\tif (trWave[v] == 1) offset = fr(offset - trVol[v]);\n\tlet o = mainOsc(v);\n\toPhase[o] = startPhase(o, offset);\n\toPhase[o + 1] = 0;\n\toPhase[o + 2] = 0;\n\toscBase(o, note);\n\toscBase(o + 1, note);\n\toscBase(o + 2, note);\n\tif (v == 5) {\n\t\tif (isOpen != 0) aeDecay[5] = hhDecOpen;\n\t\telse aeDecay[5] = hhDecClosed;\n\t}\n\taeTrigger(v);\n\tvelo[v] = fr(vel / 127);\n\ttrPhase[v] = 0;\n\tsnap[v] = 1;\n\tupdatePan(v);\n}\n\nfunction voiceTrigger(slot, vel, note) {\n\tif (slot < 3) drumTrigger(slot, vel, note);\n\telse if (slot == 3) snareTrigger(vel, note);\n\telse if (slot == 4) metalTrigger(4, vel, 0, note);\n\telse metalTrigger(5, vel, slot - 5, note);\n}\n\nfunction queueTrig(slot, code) {\n\tif (code <= 0) return;\n\ttPend[slot] = 1;\n\ttVel[slot] = code - 128 * floor(code / 128);\n\tlet n = floor(code / 128);\n\ttNote[slot] = n - 128 * floor(n / 128);\n}\n\n// calcDrumVoiceAsync\nfunction drumAsync(v) {\n\tlet o = 2 * v;\n\tlet eg = decayCalc(v);\n\toPitch[o] = fr(1 + fr(eg * pAmt[v]));\n\tif (trWave[v] == 0) oPitch[o] = fr(oPitch[o] + fr(snapCalc(v, trPitch[v]) * trVol[v]));\n\toFm[o] = fr(fmAmt[v] * eg);\n\tif (aeAttack[v] == 1 && (aeState[v] == EG_A || aeState[v] == EG_REPEAT)) {\n\t\tampIn[v] = aeCalc(v);\n\t\tlastGain[v] = ampIn[v];\n\t} else {\n\t\tlastGain[v] = ampIn[v];\n\t\tampIn[v] = aeCalc(v);\n\t}\n\toscSetFreq(o);\n\toscSetFreq(o + 1);\n}\n\n// calcDrumVoiceSyncBlock -> SCR[0..63]\nfunction drumSync(v) {\n\tlet o = 2 * v;\n\toscBlock(o + 1, 64, fmAmt[v], pwm[v]);\n\tif (mixOscs[v] != 0) {\n\t\toscBlock(o, 0, fr(1 - fmAmt[v]), pwm[v]);\n\t\tqaddBuf(0, 64);\n\t} else {\n\t\toscFmBlock(o, 64, 0, 1, pwm[v]);\n\t}\n\ttransBlock(v, 64);\n\tqaddBuf(0, 64);\n\tsvfBlock(v, 0);\n\t// amp envelope, interpolated over the block (double maths in the firmware)\n\tlet g1 = fr(ampIn[v]);\n\tlet g0 = fr(lastGain[v]);\n\tlet dg = fr(g1 - g0);\n\tfor (let i = 0; i < N; i++) SCR[i] = i16(SCR[i] * (g0 + fr(i / 63) * dg));\n\tif (volMod[v] != 0) {\n\t\tfor (let i = 0; i < N; i++) SCR[i] = i16(fr(SCR[i] * velo[v]));\n\t}\n\t// drive with smoothed amount, then smoothed volume\n\tfor (let i = 0; i < N; i++) {\n\t\tdriveB[v] = fr(driveB[v] + 0.009999999776482582 * fr(dShape[v] - driveB[v]));\n\t\tSCR[i] = shapeSample(SCR[i], driveB[v]);\n\t}\n\tfor (let i = 0; i < N; i++) {\n\t\tmixVolB[v] = fr(mixVolB[v] + 0.009999999776482582 * fr(vol[v] - mixVolB[v]));\n\t\tfader[v] = fr(fader[v] + 0.009999999776482582 * fr(1 - fader[v]));\n\t\tSCR[i] = i16(fr(SCR[i] * fr(mixVolB[v] * fader[v])));\n\t}\n}\n\nfunction snareAsync() {\n\tlet eg = decayCalc(3);\n\toPitch[6] = fr(1 + fr(eg * pAmt[3]));\n\tegVol[3] = fr(aeCalc(3));\n\tif (trWave[3] == 0) oPitch[6] = fr(oPitch[6] + fr(snapCalc(3, trPitch[3]) * trVol[3]));\n\toscSetFreq(6);\n\toscSetFreq(7);\n}\n\n// Snare_calcSyncBlock -> SCR[0..63]\nfunction snareSync() {\n\tnoiseBlock(7, 0, 0.8999999761581421);\n\tsvfBlock(3, 0);\n\toscBlock(6, 64, fr(1 - snMix), pwm[3]);\n\ttransBlock(3, 128);\n\tlet cv = fr(vol[3] * egVol[3]);\n\tif (volMod[3] != 0) cv = fr(fr(vol[3] * velo[3]) * egVol[3]);\n\tfor (let j = 0; j < N; j++) {\n\t\tlet tmp = fr(fr(SCR[j] * snMix + SCR[64 + j]) + SCR[128 + j]);\n\t\tfader[3] = fr(fader[3] + 0.10000000149011612 * fr(1 - fader[3]));\n\t\tSCR[j] = i16(fr(fr(cv * tmp) * fader[3]));\n\t}\n\tdistBlock(3, 0);\n}\n\nfunction metalAsync(v) {\n\tlet o = mainOsc(v);\n\tegVol[v] = fr(aeCalc(v));\n\tif (trWave[v] == 0) oPitch[o] = fr(1 + fr(snapCalc(v, trPitch[v]) * trVol[v]));\n\toscSetFreq(o);\n\toscSetFreq(o + 1);\n\toscSetFreq(o + 2);\n}\n\n// Cymbal_calcSyncBlock / HiHat_calcSyncBlock -> SCR[0..63]\nfunction metalSync(v) {\n\tlet o = mainOsc(v);\n\toscBlock(o + 1, 64, fmA1[v], pwm[v]);\n\toscBlock(o + 2, 128, fmA2[v], pwm[v]);\n\tqaddBuf(64, 128);\n\tlet gain = 1;\n\tif (v == 5) gain = 0.5;\n\toscFmBlock(o, 64, 0, gain, pwm[v]);\n\tsvfBlock(v, 0);\n\ttransBlock(v, 64);\n\tlet cv = fr(vol[v] * egVol[v]);\n\tif (volMod[v] != 0) cv = fr(fr(vol[v] * velo[v]) * egVol[v]);\n\tqaddBuf(0, 64);\n\tfor (let j = 0; j < N; j++) {\n\t\tfader[v] = fr(fader[v] + 0.10000000149011612 * fr(1 - fader[v]));\n\t\tSCR[j] = i16(fr(SCR[j] * fr(cv * fader[v])));\n\t}\n\tdistBlock(v, 0);\n}\n\n// ================================================================ FX bus\nfunction compSetRatio(r) {\n\tif (r == 1) cRatio = 0.5;\n\telse if (r == 2) cRatio = 1 / 3;\n\telse if (r == 3) cRatio = 0.25;\n\telse if (r == 4) cRatio = 1 / 6;\n\telse if (r == 5) cRatio = 0.125;\n\telse cRatio = 1;\n}\n\n// FxBus_updateParameter\nfunction fxUpdate() {\n\tif (fxType == 1) {\n\t\tdsDrive = fxP[0];\n\t\tdsP1 = fxP[1];\n\t\tdsP2 = fxP[2];\n\t\tdsP3 = fxP[3];\n\t} else if (fxType == 2) {\n\t\toFreq[14] = fr(fxP[0] * 880);\n\t\toscSetFreq(14);\n\t} else if (fxType == 3) {\n\t\t// attack/release: time in ms to reach 63 %\n\t\tcAttack = fr(exp(-1000 / fr(fr(0.029999999329447746 + fr(fxP[0] * 100)) * fsr)));\n\t\tcRelease = fr(exp(-1000 / fr(fr(25 + fr(fxP[1] * 175)) * fsr)));\n\t\tcTresh = fr(-96 + fr(fxP[2] * 96));\n\t\tcMarkup = fr(1 + fxP[3] * 2);\n\t} else if (fxType == 4) {\n\t\tdlRange = fxP[1];\n\t\tdelaySetTime(dlTime);\n\t\tdelaySetTime(fxP[0]);\n\t\tdlToneR = fr(fxP[2] * fxP[2]);\n\t\tdlFb = fxP[3];\n\t}\n}\n\n// dry/wet mix of one sample, packed back into 16 bit like __PKHBT does\nfunction fxDryWetMix(dry, wet) {\n\treturn wrap16(dry + ssat(fr((wet - dry) * fxDryWet)));\n}\n\nfunction ecc83(x) {\n\tlet inp = trunc(x);\n\tlet s = sat16(inp);\n\tlet itg = floor(s / 512) + 64;\n\tlet frac = (inp - 512 * floor(inp / 512)) / 512;\n\treturn ECC83[itg] + (ECC83[itg + 1] - ECC83[itg]) * frac;\n}\n\nfunction foldback(x) {\n\tx = fr(x);\n\tif (x > 1 || x < -1) {\n\t\tlet a = fr(x - 1);\n\t\tx = fr(abs(abs(a - 4 * trunc(a / 4)) - 2) - 1);\n\t}\n\treturn x;\n}\n\n// float diode(float in): 1N914 transfer curve\nfunction diode(x) {\n\tx = fr(x);\n\tif (x < -1) x = -1;\n\tif (x > 1) x = 1;\n\tlet index = fr(fr(x + 1) * 128);\n\tlet itg = trunc(index);\n\tif (itg >= 256) return DIODE[256];\n\tlet t = fr(index - itg);\n\tlet a = DIODE[itg];\n\treturn fr(t * DIODE[itg + 1] + fr(a - fr(t * a)));\n}\n\n// one channel of the \"clip\" (RAT) distortion\nfunction rat(c, x, gain, coff) {\n\tlet s = x / 32768 + dsLast[c] * dsP1 * 0.125;\n\tdsHp1[c] = dsHp1[c] + 0.64116641920131193922 * (s - dsHp1[c]);\n\ts = s - dsHp1[c];\n\tdsLp1[c] = dsLp1[c] + (1 - 0.1025353241628911807) * (s - dsLp1[c]);\n\ts = dsLp1[c];\n\tdsHp3[c] = dsHp3[c] + (1 - 0.99149556438154282898) * (s - dsHp3[c]);\n\ts = s - dsHp3[c];\n\tdsLp2[c] = dsLp2[c] + (1 - 0.93130041642945205043) * (s - dsLp2[c]);\n\ts = dsLp2[c] * gain;\n\tlet diff = s - dsSlew[c];\n\tif (abs(diff) > 6.79655641141821477118) {\n\t\tif (diff > 0) diff = 6.79655641141821477118;\n\t\telse diff = -6.79655641141821477118;\n\t}\n\tdsSlew[c] = dsSlew[c] + diff;\n\tif (dsSlew[c] > 4.2) dsSlew[c] = 4.2;\n\telse if (dsSlew[c] < -4.2) dsSlew[c] = -4.2;\n\tdsLp3[c] = dsLp3[c] + coff * (diode(dsSlew[c]) - dsLp3[c]);\n\tdsLast[c] = dsLp3[c] * dsP3;\n\treturn ssat(dsLast[c] * 32768);\n}\n\nfunction delayTimeSamples(cv) {\n\tlet lowMin = fr(0.0006 * fsr);\n\tlet lowMax = fr(0.02 * fsr);\n\tlet lo = flerp(lowMin, lowMax, dlRange);\n\tlet hiMax = 32767;\n\tif (dlType != 0) hiMax = fr(32767 * 0.47999998927116394);\n\tlet hi = flerp(lowMax, hiMax, dlRange);\n\treturn flerp(lo, hi, cv);\n}\n\n// interpolate(a, b, x) = a * (1 - x) + b * x in float\nfunction flerp(a, b, x) {\n\treturn fr(fr(a * fr(1 - x)) + fr(b * x));\n}\n\n// Delay_setDelayTime: retarget the read pointer with a 10 ms crossfade\nfunction delaySetTime(t) {\n\tif (dlInterp <= 0) {\n\t\tdlTime = t;\n\t\tlet offset = delayTimeSamples(fr(dlTime * dlRange));\n\t\tlet offItg = trunc(offset);\n\t\tdlFracNew = fr(offset - offItg);\n\t\tlet mask = 32768;\n\t\tif (dlType != 0) mask = 16384;\n\t\tlet r = dlWrite - 1 - offItg;\n\t\tdlNew = r - mask * floor(r / mask);\n\t\tdlInterp = 1;\n\t\tdlStep = fr(1 / fr(fsr * 0.009999999776482582));\n\t} else {\n\t\tdlPendTime = t;\n\t\tdlPending = 1;\n\t}\n}\n\nfunction dlRead(pos, frac, region) {\n\tlet mask = 32768;\n\tif (dlType != 0) mask = 16384;\n\tlet p2 = pos + 1;\n\tp2 = p2 - mask * floor(p2 / mask);\n\treturn i16(fr(flerp(DLB[region + pos], DLB[region + p2], frac) * 32767));\n}\n\nfunction dlAdvance(pos) {\n\tlet mask = 32768;\n\tif (dlType != 0) mask = 16384;\n\tpos = pos + 1;\n\treturn pos - mask * floor(pos / mask);\n}\n\n// adds the FX bus result to the output buffer(s) chosen by fxRouting\nfunction fxProcess() {\n\tlet ca = 128;\n\tlet cb = 192;\n\tlet stereo = 1;\n\tlet r = fxRouting;\n\tif (r == 1) {\n\t\tca = 0;\n\t\tcb = 64;\n\t} else if (r == 2) {\n\t\tstereo = 0;\n\t} else if (r == 3) {\n\t\tstereo = 0;\n\t\tca = 192;\n\t} else if (r == 4) {\n\t\tstereo = 0;\n\t\tca = 0;\n\t} else if (r == 5) {\n\t\tstereo = 0;\n\t\tca = 64;\n\t}\n\tlet t = fxType;\n\tif (t == 1) {\n\t\tlet coff = 0.06537948995454451662 + dsP2 * 0.92410701734426630737;\n\t\tif (dsType == 0) {\n\t\t\tlet om = fr((1.0 + 0.55 * dsP1) + 0.55 * dsP1);\n\t\t\tlet dr = fr(1 + dsDrive * 4);\n\t\t\tif (stereo == 0) dr = fr(1 + dsDrive);\n\t\t\tfor (let i = 0; i < N; i++) {\n\t\t\t\tlet l = FXB[2 * i];\n\t\t\t\tlet rr = FXB[2 * i + 1];\n\t\t\t\tdsLp3[0] = dsLp3[0] + coff * (ecc83(fr(l * dr)) - dsLp3[0]);\n\t\t\t\tlet wl = ssat(dsLp3[0] * om * dsP3 * 32768);\n\t\t\t\tif (stereo != 0) {\n\t\t\t\t\tdsLp3[1] = dsLp3[1] + coff * (ecc83(fr(rr * dr)) - dsLp3[1]);\n\t\t\t\t\tlet wr = ssat(dsLp3[1] * om * dsP3 * 32768);\n\t\t\t\t\tOUTB[cb + i] = sat16(OUTB[cb + i] + fxDryWetMix(rr, wr));\n\t\t\t\t}\n\t\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + fxDryWetMix(l, wl));\n\t\t\t}\n\t\t} else if (dsType == 1) {\n\t\t\tlet dr = fr(1 + dsDrive * 4);\n\t\t\tfor (let i = 0; i < N; i++) {\n\t\t\t\tlet l = FXB[2 * i];\n\t\t\t\tlet rr = FXB[2 * i + 1];\n\t\t\t\tdsLp3[0] = dsLp3[0] + coff * (fr(fr((l / 32768) * dr) + dsP1) - dsLp3[0]);\n\t\t\t\tlet wl = ssat(fr(fr(foldback(dsLp3[0]) * dsP3) * 32768));\n\t\t\t\tif (stereo != 0) {\n\t\t\t\t\tdsLp3[1] = dsLp3[1] + coff * (fr(fr((rr / 32768) * dr) + dsP1) - dsLp3[1]);\n\t\t\t\t\tlet wr = ssat(fr(fr(foldback(dsLp3[1]) * dsP3) * 32768));\n\t\t\t\t\tOUTB[cb + i] = sat16(OUTB[cb + i] + fxDryWetMix(rr, wr));\n\t\t\t\t}\n\t\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + fxDryWetMix(l, wl));\n\t\t\t}\n\t\t} else {\n\t\t\tlet gain = 1 + fr(dsDrive * 2304);\n\t\t\tfor (let i = 0; i < N; i++) {\n\t\t\t\tlet l = FXB[2 * i];\n\t\t\t\tlet rr = FXB[2 * i + 1];\n\t\t\t\tlet wl = rat(0, l, gain, coff);\n\t\t\t\tif (stereo != 0) {\n\t\t\t\t\tlet wr = rat(1, rr, gain, coff);\n\t\t\t\t\tOUTB[cb + i] = sat16(OUTB[cb + i] + fxDryWetMix(rr, wr));\n\t\t\t\t}\n\t\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + fxDryWetMix(l, wl));\n\t\t\t}\n\t\t}\n\t} else if (t == 2) {\n\t\toscBlock(14, 320, 1, 0.3);\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet l = FXB[2 * i];\n\t\t\tlet rr = FXB[2 * i + 1];\n\t\t\tlet m = SCR[320 + i];\n\t\t\tif (stereo != 0) {\n\t\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + fxDryWetMix(l, floor(l * m / 65536)));\n\t\t\t\tOUTB[cb + i] = sat16(OUTB[cb + i] + fxDryWetMix(rr, floor(rr * m / 65536)));\n\t\t\t} else {\n\t\t\t\tlet wet = sat16(OUTB[ca + i] + floor(l * m / 65536));\n\t\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + fxDryWetMix(l, wet));\n\t\t\t}\n\t\t}\n\t} else if (t == 3) {\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tlet l = FXB[2 * i];\n\t\t\tlet rr = FXB[2 * i + 1];\n\t\t\tlet x = l / 32768;\n\t\t\tif (stereo != 0) x = fr(0.5 * (l / 32768) + 0.5 * (rr / 32768));\n\t\t\tlet peakdB = fr(log(fr(abs(x) + 1.0E-25))) * 8.6858896380650365530225783783321;\n\t\t\tlet over = peakdB - cTresh;\n\t\t\tif (over < 0) over = 0;\n\t\t\tlet coeff = cRelease;\n\t\t\tif (over > cEnv) coeff = cAttack;\n\t\t\tcEnv = over + coeff * (cEnv - over);\n\t\t\tlet gr = fr(exp(fr(cEnv * (cRatio - 1) * 0.11512925464970228420089957273422)));\n\t\t\tif (stereo != 0) {\n\t\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + fxDryWetMix(l, ssat(l * gr * cMarkup)));\n\t\t\t\tOUTB[cb + i] = sat16(OUTB[cb + i] + fxDryWetMix(rr, ssat(rr * gr * cMarkup)));\n\t\t\t} else {\n\t\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + fxDryWetMix(l, i16(l * gr * cMarkup)));\n\t\t\t}\n\t\t}\n\t} else if (t == 4) {\n\t\tif (dlType == 0) delayNormal(ca, cb, stereo);\n\t\telse delayPingPong(ca, cb, stereo);\n\t} else {\n\t\tfor (let i = 0; i < N; i++) {\n\t\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + FXB[2 * i]);\n\t\t\tif (stereo != 0) OUTB[cb + i] = sat16(OUTB[cb + i] + FXB[2 * i + 1]);\n\t\t}\n\t}\n}\n\n// Delay_process (mono delay line fed with L+R)\nfunction delayNormal(ca, cb, stereo) {\n\tfor (let i = 0; i < N; i++) {\n\t\tlet l = FXB[2 * i];\n\t\tlet rr = FXB[2 * i + 1];\n\t\tlet smp = 0;\n\t\tif (dlInterp <= 0) {\n\t\t\tdlT0 = dlRead(dlOld, dlFracOld, 0);\n\t\t\tdlOld = dlAdvance(dlOld);\n\t\t\tsmp = dlT0;\n\t\t\tif (dlPending != 0) {\n\t\t\t\tdlPending = 0;\n\t\t\t\tdelaySetTime(dlPendTime);\n\t\t\t}\n\t\t} else {\n\t\t\tdlT0 = dlRead(dlOld, dlFracOld, 0);\n\t\t\tdlOld = dlAdvance(dlOld);\n\t\t\tdlT1 = dlRead(dlNew, dlFracNew, 0);\n\t\t\tdlNew = dlAdvance(dlNew);\n\t\t\tsmp = i16(fr(dlT0 * dlInterp) + dlT1 * (1.0 - dlInterp));\n\t\t\tdlInterp = fr(dlInterp - dlStep);\n\t\t\tif (dlInterp <= 0) {\n\t\t\t\tdlOld = dlNew;\n\t\t\t\tdlFracOld = dlFracNew;\n\t\t\t}\n\t\t}\n\t\tdlToneB = fr(dlToneB + dlToneR * fr(smp - dlToneB));\n\t\tsmp = i16(dlToneB);\n\t\tlet itg = sat16(sat16(l + rr) + i16(fr(smp * dlFb)));\n\t\tDLB[dlWrite] = f16(min(1, max(-1, fr(itg / 32767))));\n\t\tdlWrite = dlAdvance(dlWrite);\n\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + sat16(l + ssat(fr((smp - l) * fxDryWet))));\n\t\tif (stereo != 0) OUTB[cb + i] = sat16(OUTB[cb + i] + sat16(rr + ssat(fr((smp - rr) * fxDryWet))));\n\t}\n}\n\n// Delay_processPingPong: the right line lives at FX_BUFFER[0..], the left one at\n// FX_BUFFER[0x3fff..]; each output reads the other side's line\nfunction delayPingPong(ca, cb, stereo) {\n\tfor (let i = 0; i < N; i++) {\n\t\tlet l = FXB[2 * i];\n\t\tlet rr = FXB[2 * i + 1];\n\t\tlet outL = 0;\n\t\tlet outR = 0;\n\t\tif (dlInterp <= 0) {\n\t\t\tdlT0 = dlRead(dlOld, dlFracOld, 0);\n\t\t\tdlU0 = dlRead(dlOld, dlFracOld, 16383);\n\t\t\tdlOld = dlAdvance(dlOld);\n\t\t\toutL = dlT0;\n\t\t\toutR = dlU0;\n\t\t\tif (dlPending != 0) {\n\t\t\t\tdlPending = 0;\n\t\t\t\tdelaySetTime(dlPendTime);\n\t\t\t}\n\t\t} else {\n\t\t\tdlT0 = dlRead(dlOld, dlFracOld, 0);\n\t\t\tdlU0 = dlRead(dlOld, dlFracOld, 16383);\n\t\t\tdlOld = dlAdvance(dlOld);\n\t\t\tdlT1 = dlRead(dlNew, dlFracNew, 0);\n\t\t\tdlU1 = dlRead(dlNew, dlFracNew, 16383);\n\t\t\tdlNew = dlAdvance(dlNew);\n\t\t\toutL = i16(fr(dlT0 * dlInterp) + dlT1 * (1.0 - dlInterp));\n\t\t\toutR = i16(fr(dlU0 * dlInterp) + dlU1 * (1.0 - dlInterp));\n\t\t\tdlInterp = fr(dlInterp - dlStep);\n\t\t\tif (dlInterp <= 0) {\n\t\t\t\tdlOld = dlNew;\n\t\t\t\tdlFracOld = dlFracNew;\n\t\t\t}\n\t\t}\n\t\tdlToneB = fr(dlToneB + dlToneR * fr(outL - dlToneB));\n\t\toutL = i16(dlToneB);\n\t\tdlTone2B = fr(dlTone2B + dlToneR * fr(outR - dlTone2B));\n\t\toutR = i16(dlTone2B);\n\t\tDLB[16383 + dlWrite] = f16(min(1, max(-1, fr(sat16(l + i16(fr(outL * dlFb))) / 32767))));\n\t\tDLB[dlWrite] = f16(min(1, max(-1, fr(sat16(rr + i16(fr(outR * dlFb))) / 32767))));\n\t\tdlWrite = dlAdvance(dlWrite);\n\t\tOUTB[ca + i] = sat16(OUTB[ca + i] + sat16(l + ssat(fr((outL - l) * fxDryWet))));\n\t\tif (stereo != 0) OUTB[cb + i] = sat16(OUTB[cb + i] + sat16(rr + ssat(fr((outR - rr) * fxDryWet))));\n\t}\n}\n\n// ================================================================ one 64-sample block\n// mixer_calcNextSampleBlock, preceded by what happens between blocks on the hardware\n// (parameter changes, then triggers)\nfunction renderBlock() {\n\tscanParams();\n\tseqParams();\n\tseqTick();\n\tfor (let s = 0; s < 7; s++) {\n\t\tif (tPend[s] != 0) {\n\t\t\ttPend[s] = 0;\n\t\t\tvoiceTrigger(s, tVel[s], tNote[s]);\n\t\t\ttCount[s] = tCount[s] + 1;\n\t\t\tsqActive[s] = floor(0.06 * fsr / N) + 1;\n\t\t}\n\t}\n\tseqStatus();\n\tresetTargets();\n\tfor (let i = 0; i < 6; i++) modUpdate(vmDest[i], vmAmount[i], vmLast[i]);\n\tfor (let l = 0; l < 6; l++) modUpdate(lDest[l], lAmount[l], lfoCalc(l));\n\tfor (let v = 0; v < 6; v++) svfRecalc(v);\n\tdrumAsync(0);\n\tdrumAsync(1);\n\tdrumAsync(2);\n\tsnareAsync();\n\tmetalAsync(4);\n\tmetalAsync(5);\n\tfor (let i = 0; i < 256; i++) OUTB[i] = 0;\n\tfor (let i = 0; i < 128; i++) FXB[i] = 0;\n\tfor (let v = 0; v < 3; v++) {\n\t\tdrumSync(v);\n\t\tsrReduce(v, 0);\n\t\tmixAdd(v, 0);\n\t}\n\tsnareSync();\n\tsrReduce(3, 0);\n\tmixAdd(3, 0);\n\tmetalSync(4);\n\tsrReduce(4, 0);\n\tmixAdd(4, 0);\n\tmetalSync(5);\n\tsrReduce(5, 0);\n\tmixAdd(5, 0);\n\tfxProcess();\n}\n\n// ================================================================ step sequencer\nfunction bit(mask, i) {\n\treturn floor(mask / pow(2, i)) - 2 * floor(mask / pow(2, i + 1));\n}\n\n// in1: running + 2 * mute bits\nfunction seqControl(v) {\n\tlet c = floor(v + 0.5);\n\tif (c < 0) return;\n\tlet run = c - 2 * floor(c / 2);\n\tsqMutes = floor(c / 2);\n\tif (run != 0 && sqRun == 0) {\n\t\tsqGlobal = 0;\n\t\tsqTimer = 0;\n\t}\n\tsqRun = run;\n}\n\nfunction seqStepSamples() {\n\treturn fsr * 60 / curBpm / 4;\n}\n\n// steps fire at the start of the block they fall into, like the firmware's sequencer\nfunction seqTick() {\n\tif (sqRun == 0) return;\n\tsqTimer = sqTimer - N;\n\tif (sqTimer > 0) return;\n\tfor (let t = 0; t < 7; t++) {\n\t\tlet pos = sqGlobal - sqLen[t] * floor(sqGlobal / sqLen[t]);\n\t\tif (bit(sqOn[t], pos) != 0 && bit(sqMutes, t) == 0) {\n\t\t\ttPend[t] = 1;\n\t\t\ttNote[t] = 60;\n\t\t\tif (bit(sqAcc[t], pos) != 0) tVel[t] = sqAccVel;\n\t\t\telse tVel[t] = sqVel;\n\t\t}\n\t}\n\t// swing delays every second 16th by up to half a step\n\tlet d = sqSwing / 127 * 0.5;\n\tif (sqGlobal - 2 * floor(sqGlobal / 2) == 0) d = -d;\n\tsqTimer = sqTimer + seqStepSamples() * (1 - d);\n\tsqGlobal = sqGlobal + 1;\n}\n\n// state for the Move UI, as integers below 2^24 so they survive 32-bit float signals\n//   out5..out11: step bits of tracks 1-7     out12..out18: their accent bits\n//   out19: running + 2 * voice activity bits (7) + 256 * bpm\n//   out20: lengths - 1 of tracks 1-4 (4 bits each), out21: of tracks 5-7\n//   out22: last played step, modulo 720720 (divisible by every track length)\nfunction seqStatus() {\n\tlet act = 0;\n\tfor (let s = 0; s < 7; s++) {\n\t\tif (sqActive[s] > 0) {\n\t\t\tsqActive[s] = sqActive[s] - 1;\n\t\t\tact = act + pow(2, s);\n\t\t}\n\t}\n\tlet last = sqGlobal - 1;\n\tif (last < 0) last = 0;\n\tfor (let t = 0; t < 7; t++) {\n\t\tSTAT[t] = sqOn[t];\n\t\tSTAT[7 + t] = sqAcc[t];\n\t}\n\tSTAT[14] = sqRun + 2 * act + 256 * curBpm;\n\tSTAT[15] = (sqLen[0] - 1) + 16 * (sqLen[1] - 1) + 256 * (sqLen[2] - 1) + 4096 * (sqLen[3] - 1);\n\tSTAT[16] = (sqLen[4] - 1) + 16 * (sqLen[5] - 1) + 256 * (sqLen[6] - 1);\n\tSTAT[17] = last - 720720 * floor(last / 720720);\n}\n\n// ================================================================ setup\n// power-on state of the firmware's DSP structs (the *_init() functions)\nfunction engineInit() {\n\tfor (let o = 0; o < 16; o++) {\n\t\toFreq[o] = 440;\n\t\toPitch[o] = 1;\n\t\toWave[o] = 1;\n\t\toCoarse[o] = 70;\n\t\toFine[o] = 64;\n\t}\n\tfor (let v = 0; v < 3; v++) {\n\t\toWave[2 * v] = 1 + v;\n\t\toPitch[2 * v] = 0;\n\t\tfmAmt[v] = 0.5;\n\t\tmixOscs[v] = 1;\n\t\tfType[v] = F_LP;\n\t}\n\toWave[9] = W_SINE;\n\toWave[10] = W_NOISE;\n\toWave[12] = W_SINE;\n\toWave[13] = W_NOISE;\n\toFm[8] = 1;\n\toFm[11] = 1;\n\toFreq[14] = 100;\n\toWave[14] = 3;\n\toscSetFreq(14);\n\tfor (let v = 0; v < 6; v++) {\n\t\tvol[v] = 0.8;\n\t\tvolMod[v] = 1;\n\t\tpAmt[v] = 0.5;\n\t\tdShape[v] = 2 * (-0.0078125) / (1 + 0.0078125);\n\t\ttrPitch[v] = 1;\n\t\ttrVol[v] = 1;\n\t\taeAttack[v] = 0.01;\n\t\taeDecay[v] = 0.01;\n\t\t// slopeEg2_setSlope(eg, 0.5f) truncates 0.5 to 0\n\t\tlet a = -0.5 * 1.999;\n\t\taeSlope[v] = 2 * a / (1 - a);\n\t\taeInv[v] = -2 * a / (1 + a);\n\t\tpeDecay[v] = 0.01;\n\t\tsvF[v] = 0.1125;\n\t\tsvQ[v] = 0.9;\n\t\tsvDrive[v] = 0.315;\n\t\tlInc[v] = 1;\n\t\tlFreq[v] = 1;\n\t\tfmA1[v] = 0.5;\n\t\tfmA2[v] = 0.5;\n\t\tdecRate[v] = 1;\n\t}\n\tdecRate[6] = 1;\n\tfor (let k = 0; k < 24; k++) rngS[k] = wrap32(625341585 + k * 2654435769);\n\tfor (let i = 0; i < 256; i++) P[i] = -1;\n}\n\nfunction dspsetup() {\n\tfsr = samplerate();\n\tkr = FS_REF / fsr;\n\tif (booted == 0) {\n\t\ttablesInit();\n\t\tengineInit();\n\t\tbooted = 1;\n\t}\n\t// send every parameter again so rate dependent values follow the new sample rate\n\tfor (let i = 0; i < 256; i++) P[i] = -1;\n\tblockPos = N;\n}\n\n// Apply parameters that changed since the last block. The order is the one the\n// firmware uses when it loads a kit: modulation targets first, then\n// preset_sendDrumsetParameters()'s parameterOrder.\nfunction scanParams() {\n\tlet v = 0;\n\tv = pint(d1_vel_dest, 228);\n\tif (v != P[149]) {\n\t\tP[149] = v;\n\t\tsetVeloDest(0, v);\n\t}\n\tv = pint(d1_lfo_dest, 228);\n\tif (v != P[167]) {\n\t\tP[167] = v;\n\t\tsetLfoDest(0, v);\n\t}\n\tv = pint(d2_vel_dest, 228);\n\tif (v != P[150]) {\n\t\tP[150] = v;\n\t\tsetVeloDest(1, v);\n\t}\n\tv = pint(d2_lfo_dest, 228);\n\tif (v != P[168]) {\n\t\tP[168] = v;\n\t\tsetLfoDest(1, v);\n\t}\n\tv = pint(d3_vel_dest, 228);\n\tif (v != P[151]) {\n\t\tP[151] = v;\n\t\tsetVeloDest(2, v);\n\t}\n\tv = pint(d3_lfo_dest, 228);\n\tif (v != P[169]) {\n\t\tP[169] = v;\n\t\tsetLfoDest(2, v);\n\t}\n\tv = pint(sn_vel_dest, 228);\n\tif (v != P[152]) {\n\t\tP[152] = v;\n\t\tsetVeloDest(3, v);\n\t}\n\tv = pint(sn_lfo_dest, 228);\n\tif (v != P[170]) {\n\t\tP[170] = v;\n\t\tsetLfoDest(3, v);\n\t}\n\tv = pint(cy_vel_dest, 228);\n\tif (v != P[153]) {\n\t\tP[153] = v;\n\t\tsetVeloDest(4, v);\n\t}\n\tv = pint(cy_lfo_dest, 228);\n\tif (v != P[171]) {\n\t\tP[171] = v;\n\t\tsetLfoDest(4, v);\n\t}\n\tv = pint(hh_vel_dest, 228);\n\tif (v != P[154]) {\n\t\tP[154] = v;\n\t\tsetVeloDest(5, v);\n\t}\n\tv = pint(hh_lfo_dest, 228);\n\tif (v != P[172]) {\n\t\tP[172] = v;\n\t\tsetLfoDest(5, v);\n\t}\n\tv = pint(fx_drive_type, 2);\n\tif (v != P[237]) setLxrParam(237, v);\n\tv = pint(fx_p1, 127);\n\tif (v != P[238]) setLxrParam(238, v);\n\tv = pint(fx_p2, 127);\n\tif (v != P[239]) setLxrParam(239, v);\n\tv = pint(fx_p3, 127);\n\tif (v != P[240]) setLxrParam(240, v);\n\tv = pint(fx_p4, 127);\n\tif (v != P[241]) setLxrParam(241, v);\n\tv = pint(fx_comp_ratio, 5);\n\tif (v != P[242]) setLxrParam(242, v);\n\tv = pint(fx_ring_wave, 5);\n\tif (v != P[243]) setLxrParam(243, v);\n\tv = pint(fx_delay_type, 1);\n\tif (v != P[245]) setLxrParam(245, v);\n\tv = pint(fx_type, 4);\n\tif (v != P[234]) setLxrParam(234, v);\n\tv = pint(fx_out, 5);\n\tif (v != P[235]) setLxrParam(235, v);\n\tv = pint(fx_mix, 100);\n\tif (v != P[236]) setLxrParam(236, v);\n\tv = pint(d1_wave, 5);\n\tif (v != P[1]) setLxrParam(1, v);\n\tv = pint(d1_coarse, 127);\n\tif (v != P[8]) setLxrParam(8, v);\n\tv = pint(d1_fine, 127);\n\tif (v != P[9]) setLxrParam(9, v);\n\tv = pint(d1_fm_wave, 5);\n\tif (v != P[20]) setLxrParam(20, v);\n\tv = pint(d1_cutoff, 127);\n\tif (v != P[37]) setLxrParam(37, v);\n\tv = pint(d1_reso, 127);\n\tif (v != P[43]) setLxrParam(43, v);\n\tv = pint(d1_attack, 127);\n\tif (v != P[49]) setLxrParam(49, v);\n\tv = pint(d1_decay, 127);\n\tif (v != P[50]) setLxrParam(50, v);\n\tv = pint(d1_slope, 127);\n\tif (v != P[62]) setLxrParam(62, v);\n\tv = pint(d1_pitch_decay, 127);\n\tif (v != P[70]) setLxrParam(70, v);\n\tv = pint(d1_pitch_amount, 127);\n\tif (v != P[74]) setLxrParam(74, v);\n\tv = pint(d1_pitch_slope, 127);\n\tif (v != P[78]) setLxrParam(78, v);\n\tv = pint(d1_fm_amount, 127);\n\tif (v != P[82]) setLxrParam(82, v);\n\tv = pint(d1_fm_coarse, 127);\n\tif (v != P[83]) setLxrParam(83, v);\n\tv = pint(d1_volume, 127);\n\tif (