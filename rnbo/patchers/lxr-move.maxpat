s, 65535);\n\tsqAcc[3] = pint(seq_sn_accents, 65535);\n\tsqAcc[4] = pint(seq_cy_accents, 65535);\n\tsqAcc[5] = pint(seq_ch_accents, 65535);\n\tsqAcc[6] = pint(seq_oh_accents, 65535);\n\tsqLen[0] = max(1, pint(seq_d1_length, 16));\n\tsqLen[1] = max(1, pint(seq_d2_length, 16));\n\tsqLen[2] = max(1, pint(seq_d3_length, 16));\n\tsqLen[3] = max(1, pint(seq_sn_length, 16));\n\tsqLen[4] = max(1, pint(seq_cy_length, 16));\n\tsqLen[5] = max(1, pint(seq_ch_length, 16));\n\tsqLen[6] = max(1, pint(seq_oh_length, 16));\n\tsqSwing = pint(seq_swing, 127);\n\tsqVel = max(1, pint(seq_velocity, 127));\n\tsqAccVel = max(1, pint(seq_accent_velocity, 127));\n}\n\n// unpack 3 x 16 bit per number\nfunction fillSine(base, c: list) {\n\tfor (let i = 0; i < c.length; i++) {\n\t\tlet n = c[i];\n\t\tfor (let k = 0; k < 3; k++) {\n\t\t\tlet idx = base * 3 + i * 3 + k;\n\t\t\tlet u = n - 65536 * floor(n / 65536);\n\t\t\tn = floor(n / 65536);\n\t\t\tif (idx < 4097) SINE[idx] = u - 32768;\n\t\t}\n\t}\n}\n\nfunction fillWave(base, c: list) {\n\tfor (let i = 0; i < c.length; i++) {\n\t\tlet n = c[i];\n\t\tfor (let k = 0; k < 3; k++) {\n\t\t\tlet idx = base * 3 + i * 3 + k;\n\t\t\tlet u = n - 65536 * floor(n / 65536);\n\t\t\tn = floor(n / 65536);\n\t\t\tif (idx < 33795) WT[idx] = u - 32768;\n\t\t}\n\t}\n}\n\n// unpack 6 x 8 bit per number\nfunction fillTransient(base, c: list) {\n\tfor (let i = 0; i < c.length; i++) {\n\t\tlet n = c[i];\n\t\tfor (let k = 0; k < 6; k++) {\n\t\t\tlet idx = base * 6 + i * 6 + k;\n\t\t\tlet u = n - 256 * floor(n / 256);\n\t\t\tn = floor(n / 256);\n\t\t\tif (idx < 26460) TR[idx] = u - 128;\n\t\t}\n\t}\n}\n\nfunction fillList(which, c: list) {\n\tfor (let i = 0; i < c.length; i++) {\n\t\tif (which == 0) ECC83[i] = c[i];\n\t\telse if (which == 1) DIODE[i] = c[i];\n\t\telse if (which == 2) NOTEF[i] = c[i];\n\t\telse if (which == 3) MT[i] = c[i];\n\t\telse HASPTR[c[i]] = 1;\n\t}\n}\n\n// firmware tables: wavetable.c, transientTables.c, FX/Distortion.c, MidiNoteNumbers.h\nfunc