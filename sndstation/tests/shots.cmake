# ctest: the app draws every screen headless, and each one is a picture.
file(REMOVE_RECURSE ${DIR})
file(MAKE_DIRECTORY ${DIR})
execute_process(COMMAND ${APP} --shots ${DIR} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if (NOT rc EQUAL 0)
    message(FATAL_ERROR "lxr-sndstation --shots failed (${rc}):\n${out}\n${err}")
endif()
# drawn in Open Sans, every face of it, and in no JetBrains face at any point
string(TOLOWER "${out}\n${err}" log)
if (log MATCHES "jetbrains")
    message(FATAL_ERROR "a JetBrains face was named:\n${out}\n${err}")
endif()
if (NOT out MATCHES "lxr: Open Sans from ")
    message(FATAL_ERROR "the app did not say where Open Sans came from:\n${out}\n${err}")
endif()
foreach (screen seq step sound pattern project)
    set(f ${DIR}/lxr-${screen}.bmp)
    if (NOT EXISTS ${f})
        message(FATAL_ERROR "no ${f}:\n${out}")
    endif()
    file(SIZE ${f} size)
    if (size LESS 10000)
        message(FATAL_ERROR "${f} is only ${size} bytes")
    endif()
endforeach()
